@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(SQLite3)
if(TARGET SQLite::SQLite3)
    set_target_properties(SQLite::SQLite3 PROPERTIES DEPRECATION "")
elseif(TARGET SQLite3::SQLite3)
    add_library(SQLite::SQLite3 INTERFACE IMPORTED)
    target_link_libraries(SQLite::SQLite3 INTERFACE SQLite3::SQLite3)
endif()
@CODEFIRST_POSTGRES_FIND_DEPENDENCY@

include("${CMAKE_CURRENT_LIST_DIR}/CodeFirstCppDBTargets.cmake")
check_required_components(CodeFirstCppDB)
