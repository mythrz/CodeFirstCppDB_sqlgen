{
  "version": 4,
  "configurePresets": [
    {
      "name": "gcc-debug",
      "displayName": "GCC 16+ Debug",
      "description": "Debug build using GCC 16+ (Ninja, C++26 Reflection)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux/arch/gcc/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "gcc-release",
      "displayName": "GCC 16+ Release",
      "description": "Release build using GCC 16+ (Ninja, C++26 Reflection)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux/arch/gcc/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "gcc-asan",
      "displayName": "GCC 16+ ASan + UBSan",
      "description": "Debug build with AddressSanitizer, UndefinedBehaviorSanitizer, and libstdc++ assertions",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux/arch/gcc/asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -D_GLIBCXX_ASSERTIONS",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-gcc-debug",
      "configurePreset": "gcc-debug",
      "displayName": "Build GCC Debug",
      "jobs": 0
    },
    {
      "name": "build-gcc-release",
      "configurePreset": "gcc-release",
      "displayName": "Build GCC Release",
      "jobs": 0
    },
    {
      "name": "build-gcc-asan",
      "configurePreset": "gcc-asan",
      "displayName": "Build GCC ASan + UBSan",
      "jobs": 0
    }
  ],
  "testPresets": [
    {
      "name": "test-gcc-debug",
      "configurePreset": "gcc-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-gcc-release",
      "configurePreset": "gcc-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-gcc-asan",
      "configurePreset": "gcc-asan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
